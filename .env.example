# Copy to .env and fill in. NEVER commit .env (CLAUDE.md constraint 7).

# --- Network: Sepolia. Verified on-chain, see docs/friction.md F4. ---
STARKNET_CHAIN_ID=SN_SEPOLIA
STARKNET_RPC_URL=

# Privacy pool v2.0, live on Sepolia.
# get_version()='2.0'  get_proof_validity_blocks()=450  get_fee_amount()=0
POOL_ADDRESS=0x0254a6b2997ef52e9f830ce1f543f6b29768295e8d17e2267d672c552cfe0d91

# --- Off-chain services ---
# BLOCKER: no public Sepolia proving-service endpoint is published (friction.md F5).
# Without this there is no proof, and apply_actions reverts on EMPTY_PROOF_FACTS.
PROVING_SERVICE_URL=

# Optional. Unset -> use ContractDiscoveryProvider over plain RPC instead.
INDEXER_URL=

# --- Key material: never commit real values. Testnet keys included. ---
AGENT_ADDRESS=
AGENT_PRIVATE_KEY=
AGENT_VIEWING_KEY=
