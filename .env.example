# Copy to .env and fill in. NEVER commit .env (CLAUDE.md constraint 7).

# --- Network: Sepolia. Verified on-chain, see docs/friction.md F4. ---
# Felt encoding of "SN_SEPOLIA"; erebus-cli accepts hex felts, not network-name strings.
STARKNET_CHAIN_ID=0x534e5f5345504f4c4941
# Testnet-only convenience. compile_actions exposes the pool key to this RPC.
# Product writes require an operator-controlled Pathfinder.
STARKNET_RPC_URL=https://starknet-sepolia-rpc.publicnode.com

# Privacy pool v2.0, live on Sepolia.
# get_version()='2.0'  get_proof_validity_blocks()=450  get_fee_amount()=0
POOL_ADDRESS=0x0254a6b2997ef52e9f830ce1f543f6b29768295e8d17e2267d672c552cfe0d91

# --- Off-chain services ---
# No shared endpoint is published. Use the operator-specific endpoint supplied by StarkWare
# for the MVP, or an operator-controlled prover for product use.
# Without this there is no proof, and apply_actions reverts on EMPTY_PROOF_FACTS.
PROVING_SERVICE_URL=

# Optional. Unset -> use ContractDiscoveryProvider over plain RPC instead.
INDEXER_URL=

# --- Identity: paths only; never put private-key values in .env. ---
AGENT_ADDRESS=
POOL_KEY_FILE=
ACCOUNT_KEY_FILE=
EREBUS_STATE_DIR=
TOKEN_ADDRESS=
