# Copy this file to juno.env on the remote host. Never commit juno.env.

# Juno requires an Ethereum mainnet WebSocket endpoint for L1 verification.
ETHEREUM_WS_URL=wss://replace-with-your-ethereum-mainnet-endpoint

# The official pruned snapshot extracts to this directory.
JUNO_DATA_DIR=/srv/erebus/juno_mainnet_pruned

# Both services bind to remote loopback. Reach them through an SSH tunnel.
JUNO_HTTP_PORT=6060
PROVER_HTTP_PORT=3000
