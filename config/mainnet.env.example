# Erebus Protocol 5 — mainnet MCP identity template (0.3.0 onboarding; erebus-init writes this for you).
# Copy this file outside the repository, fill placeholders, and chmod it 0600.

EREBUS_BACKEND=seam
EREBUS_NETWORK=mainnet
EREBUS_SETTLEMENT_ROLE=payer

# Operator-selected services. Both endpoints receive the pool key during proving/preflight.
STARKNET_RPC_URL=
PROVING_SERVICE_URL=https://api.starkscan.co/v1/SN_MAIN/prove
STARKSCAN_API_KEY=

# The selected network supplies the canonical mainnet chain ID and pool address.
# Set overrides only for diagnosis; a conflict is rejected at startup.
# STARKNET_CHAIN_ID=0x534e5f4d41494e
# POOL_ADDRESS=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a

TOKEN_ADDRESS=
AGENT_ADDRESS=
POOL_KEY_FILE=
ACCOUNT_KEY_FILE=
EREBUS_STATE_DIR=
EREBUS_WIRE_VERSION=v3

# Optional guardrails enforced by the MCP server below the agent (the Starknet quickstart sets all three).
# EREBUS_REQUIRE_CANONICAL_NETWORK=1        # refuse custom chain/pool pairs at startup
# EREBUS_MAX_WRITES=3                       # lifetime cap on charged writes this identity may start
# EREBUS_SPENDING_LIMITS={"0x04718f5a0fc34cc1af16a1cdee98ffb20c31f5cd61d6ab07201858f4287c938d":{"per_deal":"200000000000000000","daily":"400000000000000000"}}
