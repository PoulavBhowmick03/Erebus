# Erebus Protocol 4 — mainnet MCP identity template.
# Copy this file outside the repository, fill placeholders, and chmod it 0600.

EREBUS_BACKEND=seam
EREBUS_NETWORK=mainnet
EREBUS_SETTLEMENT_ROLE=payer

# Operator-selected services. Both endpoints receive the pool key during proving/preflight.
STARKNET_RPC_URL=
PROVING_SERVICE_URL=https://api.starkscan.co/v1/SN_MAIN/prove
STARKSCAN_API_KEY=

# The selected network supplies the canonical mainnet chain ID and pool address.
# Set overrides only for diagnosis; a conflict is rejected at startup.
# STARKNET_CHAIN_ID=0x534e5f4d41494e
# POOL_ADDRESS=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a

TOKEN_ADDRESS=
AGENT_ADDRESS=
POOL_KEY_FILE=
ACCOUNT_KEY_FILE=
EREBUS_STATE_DIR=
EREBUS_WIRE_VERSION=v3
