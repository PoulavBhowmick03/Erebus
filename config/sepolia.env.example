# Erebus Protocol 4 — Sepolia MCP identity template.
# Copy this file outside the repository, fill placeholders, and chmod it 0600.

EREBUS_BACKEND=seam
EREBUS_NETWORK=sepolia
EREBUS_SETTLEMENT_ROLE=payer

# Operator-selected services. The RPC receives the pool key during compile_actions.
STARKNET_RPC_URL=https://starknet-sepolia-rpc.publicnode.com
PROVING_SERVICE_URL=

# The selected network supplies the canonical Sepolia chain ID and pool address.
# Set overrides only for diagnosis; a conflict is rejected at startup.
# STARKNET_CHAIN_ID=0x534e5f5345504f4c4941
# POOL_ADDRESS=0x0254a6b2997ef52e9f830ce1f543f6b29768295e8d17e2267d672c552cfe0d91

TOKEN_ADDRESS=
AGENT_ADDRESS=
POOL_KEY_FILE=
ACCOUNT_KEY_FILE=
EREBUS_STATE_DIR=
EREBUS_WIRE_VERSION=v3
